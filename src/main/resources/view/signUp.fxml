<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<GridPane alignment="CENTER" minHeight="-Infinity" minWidth="-Infinity" prefHeight="750.0" prefWidth="1100.0"
          style="-fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx/20.0.1"
          xmlns:fx="http://javafx.com/fxml/1" fx:controller="viewmodel.SignUpController">

    <columnConstraints>
        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="300.0" />
        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="300.0" />
        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
    </columnConstraints>

    <rowConstraints>
        <RowConstraints minHeight="10.0" prefHeight="100.0" vgrow="SOMETIMES" />
        <RowConstraints minHeight="10.0" prefHeight="50.0" vgrow="SOMETIMES" />
        <RowConstraints minHeight="10.0" prefHeight="50.0" vgrow="SOMETIMES" />
        <RowConstraints minHeight="10.0" prefHeight="50.0" vgrow="SOMETIMES" />
        <RowConstraints minHeight="10.0" prefHeight="50.0" vgrow="SOMETIMES" />
        <RowConstraints minHeight="10.0" prefHeight="50.0" vgrow="SOMETIMES" />
        <RowConstraints minHeight="10.0" prefHeight="50.0" vgrow="SOMETIMES" />
        <RowConstraints minHeight="10.0" prefHeight="100.0" vgrow="SOMETIMES" />
    </rowConstraints>

    <!-- Title -->
    <Label text="Create New Account" style="-fx-font-size: 24; -fx-font-weight: bold;"
           GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="0"
           GridPane.halignment="CENTER"/>

    <!-- Username -->
    <Label text="Username:" GridPane.columnIndex="1" GridPane.rowIndex="1"
           GridPane.halignment="RIGHT"/>
    <TextField fx:id="usernameField" GridPane.columnIndex="2" GridPane.rowIndex="1"/>

    <!-- Password -->
    <Label text="Password:" GridPane.columnIndex="1" GridPane.rowIndex="2"
           GridPane.halignment="RIGHT"/>
    <PasswordField fx:id="passwordField" GridPane.columnIndex="2" GridPane.rowIndex="2"/>

    <!-- Confirm Password -->
    <Label text="Confirm Password:" GridPane.columnIndex="1" GridPane.rowIndex="3"
           GridPane.halignment="RIGHT"/>
    <PasswordField fx:id="confirmPasswordField" GridPane.columnIndex="2" GridPane.rowIndex="3"/>

    <!-- Privilege Level -->
    <Label text="Account Type:" GridPane.columnIndex="1" GridPane.rowIndex="4"
           GridPane.halignment="RIGHT"/>
    <ComboBox fx:id="privilegeComboBox" GridPane.columnIndex="2" GridPane.rowIndex="4"/>

    <!-- Error Message -->
    <Label fx:id="errorLabel" GridPane.columnIndex="1" GridPane.columnSpan="2"
           GridPane.rowIndex="5" GridPane.halignment="CENTER"/>

    <!-- Buttons -->
    <HBox spacing="20" alignment="CENTER" GridPane.columnIndex="1" GridPane.columnSpan="2"
          GridPane.rowIndex="6">
        <Button fx:id="newAccountBtn" text="Create Account" onAction="#createNewAccount"
                prefWidth="150"/>
        <Button fx:id="goBackBtn" text="Back to Login" onAction="#goBack"
                prefWidth="150"/>
    </HBox>
</GridPane>